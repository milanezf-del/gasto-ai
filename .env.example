# Supabase (configurar valores reais no painel do Cloudflare Pages e no .env local)
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY="SUA_CHAVE_PUBLICA_OU_ANON_AQUI"

# Opcional: permite remoção completa da conta também no auth.users durante DELETE /api/account
# Nunca exponha esta chave no frontend (apenas Pages Functions / ambiente local)
SUPABASE_SERVICE_ROLE_KEY=""

# Opcional: Cloudflare Turnstile antirrobô no cadastro e login
# Se ausentes, o app funciona normalmente sem Turnstile
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# URL pública do aplicativo
APP_URL="http://localhost:3000"
